#!/bin/sh
set -eu

# Which harness this is comes from the account the wrapper runs as, so the
# same file serves production and the dev harness.
home="${FLUFFLES_HOME:-${HOME:?HOME must be set}}"

# Browser state lives under state/ with the rest of the runtime data. A
# harness whose browser tree predates that move is migrated in place once.
if [ -d "${home}/browser" ] && [ ! -d "${home}/state/browser" ]; then
  mkdir -p "${home}/state"
  mv "${home}/browser" "${home}/state/browser"
fi

export AGENT_BROWSER_CONFIG="${home}/state/browser/tools/agent-browser/config/config.json"
export AGENT_BROWSER_HOME="${home}/state/browser/tools/agent-browser/home"
mkdir -p "$AGENT_BROWSER_HOME"
export HOME="$AGENT_BROWSER_HOME"
exec "${home}/tools/payloads/npm/agent-browser/node_modules/.bin/agent-browser" "$@"
