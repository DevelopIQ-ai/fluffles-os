#!/bin/sh
set -eu

# Which harness this is comes from the account the wrapper runs as, so the
# same file serves production and the dev harness.
home="${FLUFFLES_HOME:-${HOME:?HOME must be set}}"

AUTOMATIONS_ROOT="${AUTOMATIONS_ROOT:-${home}/automations}"
AUTOMATIONS_STATE_DIR="${AUTOMATIONS_STATE_DIR:-${home}/state/automations}"
export AUTOMATIONS_ROOT AUTOMATIONS_STATE_DIR

cd "${home}"
exec "${home}/homebrew/bin/node" "${home}/packages/automations/dist/src/cli.js" "$@"
