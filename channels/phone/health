#!/bin/sh
set -eu

# Which harness this is comes from the account the wrapper runs as, so the
# same file serves production and the dev harness.
home="${FLUFFLES_HOME:-${HOME:?HOME must be set}}"

. "${home}/channels/phone/executor-mcp-url.sh"
export PHONE_EXECUTOR_MCP_URL

exec "${home}/packages/auth/bin/infisical-run" --path /services/phone-executor -- "${home}/homebrew/bin/node" --import tsx "${home}/channels/phone/src/agentphone-health.ts"
