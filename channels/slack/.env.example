# SLACK_BOT_TOKEN and SLACK_APP_TOKEN are injected from Infisical at runtime.
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_USERS=
SLACK_ALLOWED_CHANNELS=C0000000001,C0000000002
RESPOND_TO_DMS=false
RESPOND_TO_MENTIONS=true
SLACK_REPLY_IN_THREADS=true
SLACK_POLLING_ENABLED=false
SLACK_POLL_INTERVAL_MS=10000
SLACK_POLL_CHANNEL_REFRESH_MS=60000
SLACK_POLL_LOOKBACK_SECONDS=1800
FLUFFLES_CONTEXT_LIMITS_PATH=$HOME/config/context-limits.json
SLACK_CONTEXT_LIMIT=20
SLACK_CONTEXT_MAX_CHARS=12000
CODEX_MODEL=gpt-5.5
CODEX_WORKDIR=/path/to/home
CODEX_TIMEOUT_MS=36000000
CODEX_REASONING_EFFORT=xhigh
CODEX_SERVICE_TIER=priority
MAX_MESSAGE_CHARS=4000

SLACK_LOCAL_PROXY_PREFIX=LOCAL_PROXY:
SLACK_LOCAL_PROXY_USER=
