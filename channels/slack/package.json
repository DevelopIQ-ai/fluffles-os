{
  "name": "fluffles-channel-slack",
  "version": "1.0.0",
  "private": true,
  "description": "Slack channel for Fluffles.",
  "scripts": {
    "start": "$HOME/packages/auth/bin/infisical-run --path /services/slack -- $HOME/homebrew/bin/node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "npm run build",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@fluffles/tasks": "file:../../packages/tasks"
  }
}
