#!/usr/bin/python3
import ctypes
import hashlib
import os
import platform
import sys


def linux_identity(pid: int) -> str:
    with open("/proc/sys/kernel/random/boot_id", encoding="ascii") as boot_file:
        boot = boot_file.read().strip()
    with open(f"/proc/{pid}/stat", encoding="utf-8") as stat_file:
        stat = stat_file.read()
    fields = stat[stat.rfind(")") + 2 :].split()
    started = fields[19]
    return f"linux:{boot}:{started}"


def darwin_identity(pid: int) -> str:
    class ProcBsdInfo(ctypes.Structure):
        _fields_ = [
            ("pbi_flags", ctypes.c_uint32),
            ("pbi_status", ctypes.c_uint32),
            ("pbi_xstatus", ctypes.c_uint32),
            ("pbi_pid", ctypes.c_uint32),
            ("pbi_ppid", ctypes.c_uint32),
            ("pbi_uid", ctypes.c_uint32),
            ("pbi_gid", ctypes.c_uint32),
            ("pbi_ruid", ctypes.c_uint32),
            ("pbi_rgid", ctypes.c_uint32),
            ("pbi_svuid", ctypes.c_uint32),
            ("pbi_svgid", ctypes.c_uint32),
            ("rfu_1", ctypes.c_uint32),
            ("pbi_comm", ctypes.c_char * 16),
            ("pbi_name", ctypes.c_char * 32),
            ("pbi_nfiles", ctypes.c_uint32),
            ("pbi_pgid", ctypes.c_uint32),
            ("pbi_pjobc", ctypes.c_uint32),
            ("e_tdev", ctypes.c_uint32),
            ("e_tpgid", ctypes.c_uint32),
            ("pbi_nice", ctypes.c_int32),
            ("pbi_start_tvsec", ctypes.c_uint64),
            ("pbi_start_tvusec", ctypes.c_uint64),
        ]

    info = ProcBsdInfo()
    libproc = ctypes.CDLL("/usr/lib/libproc.dylib")
    size = libproc.proc_pidinfo(pid, 3, 0, ctypes.byref(info), ctypes.sizeof(info))
    if size != ctypes.sizeof(info) or info.pbi_pid != pid:
        raise ProcessLookupError(pid)
    return f"darwin:{info.pbi_start_tvsec}:{info.pbi_start_tvusec}"


def main() -> int:
    if len(sys.argv) != 2 or not sys.argv[1].isdigit() or int(sys.argv[1]) <= 0:
        return 64
    pid = int(sys.argv[1])
    try:
        system = platform.system()
        if system == "Linux":
            identity = linux_identity(pid)
        elif system == "Darwin":
            identity = darwin_identity(pid)
        else:
            return 69
    except (FileNotFoundError, PermissionError, ProcessLookupError, IndexError, ValueError, OSError):
        return 75
    print(hashlib.sha256(identity.encode("ascii")).hexdigest())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
