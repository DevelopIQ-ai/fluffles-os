#!/bin/sh
set -eu

apply=0
if [ "${1:-}" = "--apply" ]; then
  apply=1
elif [ "$#" -ne 0 ]; then
  echo "usage: cleanup-legacy-infisical-secrets [--apply]" >&2
  exit 64
fi

home="${FLUFFLES_HOME:-${HOME:?HOME must be set}}"
wrapper="${home}/bin/infisical-run"
plists="${home}/Library/LaunchAgents"
uid="$(id -u)"
node_bin="${NODE:-${home}/homebrew/bin/node}"
if [ ! -x "$node_bin" ]; then
  node_bin="$(command -v node)" || {
    echo "Node.js is unavailable" >&2
    exit 69
  }
fi

labels="
com.puffle.fluffles.channel.slack
com.puffle.fluffles.channel.email
com.puffle.fluffles.channel.phone
com.puffle.harness.webhooks
"

for label in $labels; do
  plist="${plists}/${label}.plist"
  if [ ! -r "$plist" ] || ! grep -q "${home}/packages/auth/bin/infisical-run" "$plist"; then
    echo "${label} is not deployed with Infisical runtime injection" >&2
    exit 69
  fi
  loaded=0
  for domain in "gui/${uid}" "user/${uid}" system; do
    if output="$(launchctl print "${domain}/${label}" 2>/dev/null)"; then
      loaded=1
      if ! printf '%s\n' "$output" | grep -q "${home}/packages/auth/bin/infisical-run"; then
        echo "${domain}/${label} is still loaded from a legacy launch definition" >&2
        exit 69
      fi
    fi
  done
  if [ "$loaded" -ne 1 ]; then
    echo "${label} is not loaded" >&2
    exit 69
  fi
done

verify_runtime() {
  "$wrapper" --path /services/slack -- /bin/sh -c '
    test -n "${SLACK_BOT_TOKEN:-}" && test -n "${SLACK_APP_TOKEN:-}"
  ' || return 1

  "$wrapper" --path /services/email-pubsub -- /bin/sh -c '
    test -n "${EMAIL_PUBSUB_PUSH_TOKEN:-}" && test -n "${AMALGM_EMAIL_INBOUND_SECRET:-}"
  ' || return 1

  "$wrapper" --path /services/phone -- /bin/sh -c '
    test -n "${PHONE_EXECUTOR_MCP_AUTHORIZATION:-}"
  ' || return 1

  for url in \
    http://127.0.0.1:3000/healthz \
    http://127.0.0.1:3001/healthz \
    http://127.0.0.1:3002/healthz \
    http://127.0.0.1:8787/healthz; do
    health_payload="$(curl -fsS --max-time 5 "$url")" || return 1
    printf '%s' "$health_payload" | "$node_bin" -e '
      let input = "";
      process.stdin.setEncoding("utf8");
      process.stdin.on("data", (chunk) => { input += chunk; });
      process.stdin.on("end", () => {
        try {
          if (JSON.parse(input).ok !== true) process.exit(1);
        } catch {
          process.exit(1);
        }
      });
    ' || return 1
  done

  if grep -q 'auth/channels/slack/secrets\.env' "${home}/channels/slack/src/server.ts" \
    || grep -q 'auth/providers/webhooks/webhooks\.env' "${home}/channels/webhooks/src/server.ts" \
    || grep -q '\.codex.*config\.toml\|PHONE_EXECUTOR_MCP_BEARER_TOKEN' "${home}/channels/phone/src/executor-mcp-client.ts"; then
    echo "deployed runtime still contains a legacy credential fallback" >&2
    return 1
  fi
}

verify_runtime

files="
${home}/auth/channels/slack/secrets.env
${home}/auth/providers/webhooks/email-pubsub.env
${home}/auth/providers/webhooks/webhooks.env
${home}/auth/registry.json
"

if [ "$apply" -ne 1 ]; then
  echo "verified Infisical injection; rerun with --apply to remove legacy local auth material"
  exit 0
fi

rollback_cleanup() {
  for file in $files; do
    backup="${file}.infisical-cleanup-backup"
    if [ -f "$backup" ] && [ ! -e "$file" ]; then
      mv "$backup" "$file" >/dev/null 2>&1 || true
    fi
  done
}

cleanup_signal() {
  status="$1"
  trap - EXIT HUP INT TERM
  rollback_cleanup
  exit "$status"
}

trap rollback_cleanup EXIT
trap 'cleanup_signal 129' HUP
trap 'cleanup_signal 130' INT
trap 'cleanup_signal 143' TERM

for file in $files; do
  backup="${file}.infisical-cleanup-backup"
  if [ -e "$backup" ]; then
    if [ -e "$file" ]; then
      echo "cleanup recovery conflict: both $file and $backup exist" >&2
      exit 70
    fi
    mv "$backup" "$file"
  fi
  if [ -e "$file" ]; then
    mv "$file" "$backup"
  fi
done

verify_runtime

for file in $files; do
  rm -f "${file}.infisical-cleanup-backup"
done
trap - EXIT HUP INT TERM
echo "removed legacy local auth material after verified Infisical deployment"
