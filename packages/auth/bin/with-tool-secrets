#!/bin/sh
set -eu

# The one place a callable tool's Infisical path is looked up. A tool's
# manifest in tools/mcp/manifests declares `secrets.path`; this helper reads
# it and hands the command to infisical-run, so no wrapper carries its own
# credential plumbing. A manifest without a secrets declaration runs the
# command as-is.
#
# usage: with-tool-secrets <manifest-name> -- <command> [args...]

# Which harness this is comes from the account the wrapper runs as, so the
# same file serves production and the dev harness.
home="${FLUFFLES_HOME:-${HOME:?HOME must be set}}"

usage() {
  echo "usage: with-tool-secrets <manifest-name> -- <command> [args...]" >&2
}

tool_name="${1:-}"
if [ -z "$tool_name" ] || [ "${2:-}" != "--" ] || [ "$#" -lt 3 ]; then
  usage
  exit 64
fi
shift 2

case "$tool_name" in
  *[!a-z0-9_.-]*|"")
    echo "with-tool-secrets: invalid manifest name: $tool_name" >&2
    exit 64
    ;;
esac

manifest="${home}/tools/mcp/manifests/${tool_name}.json"
if [ ! -f "$manifest" ] || [ -L "$manifest" ]; then
  echo "with-tool-secrets: no manifest for ${tool_name} at ${manifest}" >&2
  exit 78
fi

# The manifest is JSON, and the only durable JSON reader on a fresh harness
# is node. `secrets.path` is re-validated here so a corrupt manifest fails
# closed instead of degrading to an uncredentialed run.
secret_path="$("${home}/homebrew/bin/node" -e '
const fs = require("node:fs");
let manifest;
try {
  manifest = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
} catch (error) {
  console.error(`with-tool-secrets: unreadable manifest: ${error.message}`);
  process.exit(78);
}
const secrets = manifest.secrets;
if (secrets === undefined) process.exit(0);
if (typeof secrets !== "object" || secrets === null || Array.isArray(secrets)
  || typeof secrets.path !== "string" || !/^\/[a-z0-9][a-z0-9/_-]*$/.test(secrets.path)) {
  console.error("with-tool-secrets: manifest.secrets.path is invalid");
  process.exit(78);
}
process.stdout.write(secrets.path);
' "$manifest")"

if [ -z "$secret_path" ]; then
  exec "$@"
fi

exec "${home}/packages/auth/bin/infisical-run" --path "$secret_path" -- "$@"
