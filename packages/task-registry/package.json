{
  "name": "@fluffles/task-registry",
  "version": "1.0.0",
  "private": true,
  "description": "The passive persistent task registry: objective/status/progress/next_action/result per conversation, resumable after restarts, cancellable on stop.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@fluffles/conversations": "file:../conversations",
    "@fluffles/storage": "file:../storage"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
